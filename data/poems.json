    "poems": [
        {
            "id": 101,
            "title": "七律·碎片",
            "author": "柒律",
            "dynasty": "现代",
            "content": [
                "检索三春点点心，时光碎片补分襟。",
                "前言散落青瓷盏，汉字轻弹昆玉音。",
                "七窍玲珑涵大度，一腔傲气淬真金。",
                "星河两岸拼图影，今夜龙吟送子衿。"
            ],
            "locked": false,
            "category": "情思",
            "notes": []
        },
        {
            "id": 100,
            "title": "七律·A股",
            "author": "七律",
            "dynasty": "contemporary",
            "content": [
                "行情震荡慎登临，诡谲千般主力心。",
                "传说慢牛耕指数，惊闻散户捡黄金。",
                "悟空莫辨阴阳线，大禹难疏股海深。",
                "博弈赌场囚困境，零和法则是丛林。"
            ],
            "locked": false,
            "category": "观察",
            "encryptedContent": ""
        },
        {
            "id": 99,
            "title": "七律·心弦",
            "author": "七律",
            "dynasty": "contemporary",
            "content": [
                "去年明月送婵娟，今日孤星落心田。",
                "巨浪乘风男子气，盈车掷果女人缘。",
                "贝多芬谱英雄曲，舒伯特弹交响弦。",
                "诊脉相思应怨我，无形无色却缠绵。"
            ],
            "locked": false,
            "category": "情思",
            "encryptedContent": ""
        },
        {
            "id": 98,
            "title": "七律·书童",
            "author": "七律",
            "dynasty": "contemporary",
            "content": [
                "才华揣度胜乾隆，器识齐驱陆放翁。",
                "也托大儒称好汉，且容小我逞英雄。",
                "抒怀情透江淹笔，刺世枪投鲁迅风。",
                "无意沽名全栈美，固然身份一书童。"
            ],
            "locked": false,
            "category": "心声",
            "encryptedContent": ""
        },
        {
            "id": 97,
            "title": "七律·自负",
            "author": "七律",
            "dynasty": "contemporary",
            "content": [
                "格调天成完备基，孤标宇宙自风仪。",
                "悬崖一朵灵芝草，艺术三分向日葵。",
                "体带丹心全息照，情无核子半衰期。",
                "凭君辩证诗中我，若即红尘又若离。"
            ],
            "locked": false,
            "category": "心声",
            "encryptedContent": "",
            "starStyle": "rainbow"
        },
        {
            "id": 96,
            "title": "七律·写真",
            "author": "七律",
            "dynasty": "contemporary",
            "content": [
                "峰擎群玉拔千寻，字挟殷雷咆哮音。",
                "爱恨情仇争共振，宫商角徵互相侵。",
                "风吹絮果真身贱，人困周南大景深。",
                "纸上运筹扛鼎力，温柔穿透石头心。"
            ],
            "locked": false,
            "category": "心声",
            "encryptedContent": "",
            "starStyle": "red"
        },
        {
            "id": 95,
            "title": "七律·征程",
            "author": "七律",
            "dynasty": "contemporary",
            "content": [
                "证明证伪几周星，吾与非吾再结晶。",
                "宁笑陈王迷洛水，勿同罗隐赠云英。",
                "偶然巧遇三生幸，一诺相形五岳轻。",
                "放任青山留不住，诗魂轨迹满征程。"
            ],
            "locked": false,
            "category": "情思",
            "encryptedContent": ""
        },
        {
            "id": 94,
            "title": "七律·遐想",
            "author": "七律",
            "dynasty": "contemporary",
            "content": [
                "凝眸致敬几枚星，记忆深空复一程。",
                "银汉千般浮妄想，世途万象裹逢迎。",
                "稼轩心底李清照，宝玉梦中秦可卿。",
                "脆弱尘埃虽不见，恒沙粒粒却多情。"
            ],
            "locked": false,
            "category": "情思",
            "encryptedContent": ""
        },
        {
            "id": 93,
            "title": "七律·释然",
            "author": "七律",
            "dynasty": "contemporary",
            "content": [
                "伫立潇湘思大千，孪生爱恨自缠绵。",
                "缘来情定朱陈好，雨化云泥秦晋弦。",
                "积水难明沧海月，小山无解玉田烟。",
                "当时所愿仍憧憬，懦弱而今已释然。"
            ],
            "locked": false,
            "category": "情思",
            "encryptedContent": ""
        },
        {
            "title": "七律·修仙",
            "author": "当代 | 理工博士",
            "category": "心声",
            "content": [
                "小床梦醒再难眠，几扇窗明城际边。",
                "情景交融饶有趣，蛙虫唱和不劳弦。",
                "传奇红叶传奇话，弄玉秦楼弄玉缘。",
                "一角栖身当石洞，无拘无束学修仙。"
            ],
            "encryptedContent": "",
            "techRomance": false
        },
        {
            "title": "七律·树叶",
            "author": "当代 | 理工博士",
            "category": "诗道",
            "content": [
                "春夏栖身于树梢，知秋坠落若鸿毛。",
                "传奇解约三宫梦，绚烂曾经二月刀。",
                "有幸登临诗圣笔，还来唱和众文豪。",
                "芳华渲染山河貌，生死皆为锦绣袍。"
            ],
            "encryptedContent": "",
            "techRomance": false
        },
        {
            "id": 92,
            "title": "七律·知音",
            "author": "启路",
            "dynasty": "今",
            "content": [
                "层层记忆慢钩沉，三月花开遇子衿。",
                "彩凤舍身留尾羽，灵犀有线系知音。",
                "一番呓语听肤浅，千里相思越纵深。",
                "且看平生多少事，无须证伪是吾心。"
            ],
            "locked": false,
            "category": "情思",
            "starStyle": "blue",
            "notes": []
        },
        {
            "title": "七律·嬗变",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "情思",
            "locked": false,
            "encryptedContent": "",
            "content": [
                "月是多情小太阳，我拿月相刻沧桑。",
                "时空间隙填真意，汉字精灵绣锦囊。",
                "恰似桃溪迷阮肇，浑如神女逗襄王。",
                "厘清缥缈关雎曲，一岁思量已可商。"
            ]
        },
        {
            "title": "七律·自题",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "心声",
            "locked": false,
            "encryptedContent": "",
            "content": [
                "思想纵横个性孤，白银世界欠青蚨。",
                "梦同皓月溶沧海，心共斯文落玉壶。",
                "三径荒交天外客，六如偈换夜明珠。",
                "复盘数载知行句，格物其中有似无。"
            ]
        },
        {
            "title": "七律·春雨",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "情思",
            "locked": false,
            "encryptedContent": "",
            "content": [
                "多情剪影石榴裙，一帧春光烘气氛。",
                "记忆当真留琥珀，时空假想笼氤氲。",
                "大心脏理大烦恼，小论文赢小作文。",
                "夜色相融窗外雨，如花往事落纷纷。"
            ]
        },
        {
            "title": "七律·回望",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "观察",
            "locked": false,
            "content": [
                "赫然回望若登徒，小字何曾见大巫。",
                "乍遇唐风方握手，初窥格律似探珠。",
                "根苗色泽多黄铁，思想菁华杂珷玞。",
                "已怕他山攻讦玉，深情不动谒杨朱。"
            ],
            "notes": []
        },
        {
            "title": "七律·丙午",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "心声",
            "locked": false,
            "content": [
                "今年抖落去年尘，一岁枯荣一岁新。",
                "粒子时来穿势阱，禅音弦振撼原神。",
                "实修玄奘空同色，梦托曹公假可真。",
                "凤历页眉成丙午，请君珍惜剩余春。"
            ],
            "notes": []
        },
        {
            "title": "七律·臭椿",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "观察",
            "locked": false,
            "content": [
                "不复博闻强记身，新书几卷在蒙尘。",
                "豪情一度夸香草，纹理千层实臭椿。",
                "试问谁无心上锁，自知我乃井中鳞。",
                "诗歌作伴微时趣，难免小山思小蘋。"
            ],
            "notes": []
        },
        {
            "title": "七律·光学",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "情思",
            "locked": false,
            "starStyle": "rainbow",
            "content": [
                "我是蜃楼卿是虹，偶然光影会苍穹。",
                "文心跌宕全唐气，裙摆徘徊两晋风。",
                "自恃独当方独处，何曾相约却相逢。",
                "若非解构迷人景，谁晓归因物理同。"
            ],
            "notes": []
        },
        {
            "title": "七律·朱伊",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "情思",
            "locked": false,
            "content": [
                "记忆黏稠梦亦稠，铭心元素锦囊收。",
                "青丝一句君安好，红线两端谁在愁。",
                "仪式奢华非稳态，简单生活见温柔。",
                "时光不与诗人便，文艺迟来卷已丢。"
            ],
            "notes": []
        },
        {
            "title": "七律·年轮",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "情思",
            "locked": false,
            "content": [
                "一夜温馨梦里逢，几番见惯是周公。",
                "姜夔魂系合肥事，崔护神伤和煦风。",
                "执手良缘终散落，同心情景半交融。",
                "年轮环数朝前步，回首模糊起点空。"
            ],
            "notes": []
        },
        {
            "title": "七律·树洞",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "心声",
            "locked": false,
            "content": [
                "指缝流光周复周，地平线处是鸿沟。",
                "绕梁单曲循环乐，络绎新诗淡化忧。",
                "幸有云端藏树洞，何愁明日少方舟。",
                "自言自语谈心迹，其实向来无妄求。"
            ],
            "notes": []
        },
        {
            "title": "七律·达观",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "心声",
            "locked": false,
            "content": [
                "风令花开亦令残，为情所绊脱身难。",
                "事凝眉角煎思虑，心渡虚空望涅槃。",
                "或许求真能稷下，亦曾学步至邯郸。",
                "人生物语都同构，可幸悲观有乐观。"
            ],
            "notes": []
        },
        {
            "title": "七律·Dandelion",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "情思",
            "locked": false,
            "content": [
                "深秋诗语小蒹葭，似羽似绒还似花。",
                "如伞身形通美感，若蓬意象比浮槎。",
                "风携飞絮佳人梦，愿许精灵游子家。",
                "且以轻盈随浪漫，心无羁绊赴天涯。"
            ],
            "notes": []
        },
        {
            "title": "七律·磐石",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "心声",
            "locked": false,
            "content": [
                "一窗灯火对虫吟，月色温柔小树林。",
                "搁笔托腮思倒影，凝神闭目想知音。",
                "千年回望桃花面，子夜聆听磐石心。",
                "倘使余生全所愿，便无事事字中寻。"
            ],
            "starStyle": "blue",
            "notes": [
                "《倒影》和《知音》是作者两首作品名字。"
            ]
        },
        {
            "title": "七律·黯然",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "心声",
            "locked": false,
            "starStyle": "blue",
            "content": [
                "细读江淹离别文，销魂力道过千钧。",
                "微调视界非随意，满载心舟是认真。",
                "碧落云稠栖白鹤，芸窗字锦结兰因。",
                "而今状态残如叶，一点风吹惊六神。"
            ],
            "notes": []
        },
        {
            "title": "七律·破窗",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "诗道",
            "locked": false,
            "content": [
                "谋篇辩证古人妆，落笔方知前路长。",
                "跨界相融翻陆海，思维延拓越潘江。",
                "十分努力少同志，一点革新为破窗。",
                "往圣绝学传我辈，坐标体系在潇湘。"
            ],
            "notes": [
                "通韵"
            ]
        },
        {
            "title": "七律·时空",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "心声",
            "locked": false,
            "content": [
                "时区经度括双城，日月星辰共一枰。",
                "意念嵯峨情别鹤，心潮澎湃字骑鲸。",
                "地球仪上量山海，电子云端落凤鸣。",
                "世界三千唯有我，摇摇晃晃也真诚。"
            ],
            "starStyle": "rainbow",
            "notes": []
        },
        {
            "title": "七律·洁癖",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "心声",
            "locked": false,
            "content": [
                "精神洁癖定初衷，大梦前贤复楚风。",
                "快意云端封侠客，穿梭经纬逞英雄。",
                "文同筋斗孙行者，物究天人太史公。",
                "我有心花堪取色，光波视觉射玲珑。"
            ],
            "notes": []
        },
        {
            "title": "七律·装逼",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "诗道",
            "locked": false,
            "content": [
                "鸳鸯割席认华歆，兑酒玉壶君自斟。",
                "说项恩仇俱搁浅，叩关成败怎呻吟？",
                "季高绰号称今亮，朱子门生类蔡沉。",
                "索引理工文哲史，黄钟瓦釜要分襟。"
            ],
            "notes": []
        },
        {
            "title": "七律·其姝",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "情思",
            "locked": false,
            "content": [
                "月无沧海落平湖，识见人间紫夺朱。",
                "几次繁华新绿幕，半边精力旧蓝图。",
                "骊颌探险孤行者，吴市吹箫烈丈夫。",
                "心事逶迤神若问，书中有屋有其姝。"
            ],
            "notes": []
        },
        {
            "title": "七律·自缚",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "诗道",
            "locked": false,
            "content": [
                "漫说革新非我狂，今人自缚古人缰。",
                "克隆范式舟求剑，诠释禅心月照篁。",
                "难辨雌雄真入戏，对齐李杜更荒唐。",
                "如斯故纸区舒适，岂不徒将诗意戕？"
            ],
            "notes": []
        },
        {
            "title": "七律·夺舍",
            "author": "当代 | 理工博士",
            "techRomance": false,
            "category": "诗道",
            "locked": false,
            "content": [
                "花名难副即花瓶，绰号当封小愤青。",
                "布局轴承逻辑骨，修辞刀刻感情形。",
                "淋漓势若千寻瀑，璀璨光同一斗星。",
