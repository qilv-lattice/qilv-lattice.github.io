            "locked": true,
            "encryptedContent": ""
        },
        {
            "title": "七律·时空",
            "author": "当代 | 理工博士",
            "content": [
                "时区经度括双城，日月星辰共一枰。",
                "意念嵯峨情别鹤，心潮澎湃字骑鲸。",
                "地球仪上量山海，电子云端落凤鸣。",
                "世界三千唯有我，摇摇晃晃却真诚。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "心声"
        },
        {
            "title": "情感珍藏-3",
            "author": "当代 | 理工博士",
            "content": [
                "此作品已加锁，请输入密码查看。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "观察",
            "locked": true,
            "encryptedContent": ""
        },
        {
            "title": "七律·洁癖",
            "author": "当代 | 理工博士",
            "content": [
                "精神洁癖定初衷，大梦前贤复楚风。",
                "快意云端封侠客，穿梭经纬逞英雄。",
                "文同筋斗孙行者，物究天人太史公。",
                "我有心花堪取色，光波视觉射玲珑。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "心声"
        },
        {
            "title": "七律·装逼",
            "author": "当代 | 理工博士",
            "content": [
                "鸳鸯割席认华歆，兑酒玉壶君自斟。",
                "说项恩仇俱搁浅，叩关成败怎呻吟？",
                "季高绰号称今亮，朱子门生类蔡沉。",
                "索引理工文哲史，黄钟瓦釜要分襟。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "诗道"
        },
        {
            "title": "七律·其姝",
            "author": "当代 | 理工博士",
            "content": [
                "月无沧海落平湖，识见人间紫夺朱。",
                "几次繁华新绿幕，半边精力旧蓝图。",
                "骊颌探险孤行者，吴市吹箫烈丈夫。",
                "心事逶迤神若问，书中有屋有其姝。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "情思"
        },
        {
            "title": "七律·自缚",
            "author": "当代 | 理工博士",
            "content": [
                "漫说革新非我狂，今人自缚古人缰。",
                "克隆范式舟求剑，诠释禅心月照篁。",
                "难辨雌雄真入戏，对齐李杜更荒唐。",
                "如斯故纸区舒适，岂不徒将诗意戕？"
            ],
            "notes": [],
            "techRomance": false,
            "category": "诗道"
        },
        {
            "title": "七律·夺舍",
            "author": "当代 | 理工博士",
            "content": [
                "花名难副即花瓶，绰号当封小愤青。",
                "布局轴承逻辑骨，修辞刀刻感情形。",
                "淋漓势若千寻瀑，璀璨光同一斗星。",
                "拙作果真能夺舍，只因字字似叮咛。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "诗道"
        },
        {
            "title": "七律·悲观",
            "author": "当代 | 理工博士",
            "content": [
                "人生钢印盖潇湘，野性基因自带狂。",
                "历史文明层皱褶，先民知识目琳琅。",
                "近来烧脑从玄妙，愈发捉襟于智商。",
                "只怕时空它未老，才情而我过中央。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "心声"
        },
        {
            "title": "七律·自叙",
            "author": "当代 | 理工博士",
            "content": [
                "念念难求唯一求，磨平棱角自然收。",
                "因人热灶梁鸿耻，奉谕同餐何鲁羞。",
                "甚幸钟仪真向楚，惜哉王粲错依刘。",
                "孤鸾镜舞寻常事，风骨压身无理由。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "心声"
        },
        {
            "title": "七律·昆仑",
            "author": "当代 | 理工博士",
            "content": [
                "天真沉淀少年春，有幸凡鱼过禹门。",
                "方外方知新世界，洞中洞察旧乾坤。",
                "怀疑资质低能力，遭遇母胎高自尊。",
                "几纸文章心做注，此行跬步向昆仑。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "心声"
        },
        {
            "title": "七律·禅关",
            "author": "当代 | 理工博士",
            "content": [
                "直把忧思写入禅，一关叠上涅槃关。",
                "突围困厄研毛选，激活诗魂召义山。",
                "慧极伊人知婉转，情难大我懂回环。",
                "今时过去将来景，处处风光不可删。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "心声"
        },
        {
            "title": "七律·暗影",
            "author": "当代 | 理工博士",
            "content": [
                "自我度量身几斤，天资愈钝愈殷勤。",
                "风流势必争公瑾，原始生吞重孟贲。",
                "五十三参心有岸，百零八种业成文。",
                "月光暗影藏宏愿，来世翻书看此君。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "心声"
        },
        {
            "title": "七律·初心",
            "author": "当代 | 理工博士",
            "content": [
                "葱根手指扣情弦，曲谱时光俱锦年。",
                "愿遂文君吟白首，果同韩氏寄红笺。",
                "巫山梦境峰连海，缘分蓝田玉吐烟。",
                "已惯繁华千百变，心花底色似从前。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "情思"
        },
        {
            "title": "七律·玫瑰",
            "author": "当代 | 理工博士",
            "content": [
                "若然颓废听惊雷，难许蹉跎岁月堆。",
                "气质游离烟火味，才情错失美人胚。",
                "积分无限求全点，遍历千辛如愿回。",
                "试问由谁娱自己，原来文字似玫瑰。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "情思"
        },
        {
            "title": "七律·薔薇",
            "author": "当代 | 理工博士",
            "content": [
                "小杜題詩氣質新，義山偏愛更無倫。",
                "柔情滲透莎翁筆，猛虎聽聞野客身。",
                "卿憶昔年三月季，花開少女兩天真。",
                "如今我借玫瑰字，許願薔薇遇故人。"
            ],
            "notes": [
                "2025年一段云端往事，知交甚少，记忆颇多，遂成文。"
            ],
            "techRomance": false,
            "category": "情思"
        },
        {
            "title": "七律·春秋",
            "author": "当代 | 理工博士",
            "content": [
                "掩掩遮遮虽不如，情怀应胜百年初。",
                "三坟强挖唐虞典，一室精装鲁壁书。",
                "赢学对冲卑与降，赞歌调制减和除。",
                "而今若选心安地，唯有云端可结庐。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "观察"
        },
        {
            "title": "七律·求是",
            "author": "当代 | 理工博士",
            "content": [
                "求是躬行又忆公，调查权重发言同。",
                "图存力辟新思路，理论严批假大空。",
                "黄土寒窑生实践，菊香书屋拒书虫。",
                "何劳刀捉二乔笔，学问形成亲自风。"
            ],
            "notes": [
                "二乔乃胡乔木和乔冠华。"
            ],
            "techRomance": false,
            "category": "观察"
        },
        {
