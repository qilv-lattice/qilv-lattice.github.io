    "poems": [
        {
            "title": "七律·光学",
            "author": "当代 | 理工博士",
            "content": [
                "我是蜃楼卿是虹，偶然闪现遇苍穹。",
                "文心跌宕全唐气，裙摆徘徊林下风。",
                "自恃独当方独处，何曾相约却相逢。",
                "若非解构迷人景，谁晓归因物理同。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "情思"
        },
        {
            "title": "七律·朱伊",
            "author": "当代 | 理工博士",
            "content": [
                "岁月迷情梦亦稠，心灵微距笔端收。",
                "青丝一句君安好，红线两端谁在愁。",
                "仪式奢华非稳态，简单生活见温柔。",
                "时光不与斯人便，文艺迟来卷已丢。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "情思"
        },
        {
            "title": "七律·年轮",
            "author": "当代 | 理工博士",
            "content": [
                "昨夜重逢在梦中，醒来习惯又周公。",
                "姜夔留念合肥事，崔护伤怀人面红。",
                "执手良缘终散落。同心情景半交融。",
                "年轮环数朝前步，回首模糊点滴空。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "情思"
        },
        {
            "title": "七律·树洞",
            "author": "当代 | 理工博士",
            "content": [
                "指缝流光周复周，地平线处是鸿沟。",
                "绕梁单曲循环乐，络绎新诗淡化忧。",
                "幸有云端藏树洞，何愁明日少方舟。",
                "自言自语谈心迹，其实向来无妄求。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "心声"
        },
        {
            "title": "七律·达观",
            "author": "当代 | 理工博士",
            "content": [
                "风令花开亦令残，为情所绊脱身难。",
                "事凝眉角煎思虑，心渡虚空望涅槃。",
                "或许求真能稷下，亦曾学步至邯郸。",
                "人生物语都同构，可幸悲观有乐观。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "心声"
        },
        {
            "title": "七律·Dandelion",
            "author": "当代 | 理工博士",
            "content": [
                "深秋诗语小蒹葭，似羽似绒还似花。",
                "如伞身形通美感，若蓬意象比浮槎。",
                "风携飞絮佳人梦，愿许精灵游子家。",
                "且以轻盈随浪漫，心无羁绊赴天涯。"
            ],
            "notes": [],
            "techRomance": false,
            "category": "情思"
        },
        {
            "title": "情感珍藏-1",
